{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Q1 absolute scenario input",
  "description": "Input specification only. No missing coordinate or time receives a numeric default.",
  "type": "object",
  "required": [
    "schema_version",
    "scenario_id",
    "scenario_type",
    "time_origin",
    "locked_at_8000m",
    "ship",
    "missile",
    "uav",
    "operating_radius_interpretation",
    "earliest_command_time"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "scenario_id": {"type": "string", "minLength": 1},
    "scenario_type": {"enum": ["real_scenario", "synthetic_validation"]},
    "time_origin": {"type": "number"},
    "locked_at_8000m": {"type": "boolean"},
    "ship": {
      "type": "object",
      "required": ["initial_position", "heading_or_velocity"],
      "properties": {
        "initial_position": {"$ref": "#/$defs/vector2"},
        "heading_or_velocity": {"$ref": "#/$defs/vector2"}
      },
      "additionalProperties": false
    },
    "missile": {
      "type": "object",
      "required": ["initial_position", "initial_heading"],
      "properties": {
        "initial_position": {"$ref": "#/$defs/vector2"},
        "initial_heading": {"$ref": "#/$defs/vector2"}
      },
      "additionalProperties": false
    },
    "uav": {
      "type": "object",
      "required": ["initial_position", "initial_heading", "launch_reference_point"],
      "properties": {
        "initial_position": {"$ref": "#/$defs/vector2"},
        "initial_heading": {"$ref": "#/$defs/vector2"},
        "launch_reference_point": {"$ref": "#/$defs/vector2"}
      },
      "additionalProperties": false
    },
    "operating_radius_interpretation": {
      "const": "relative_to_uav_launch_reference_point"
    },
    "earliest_command_time": {"type": "number"},
    "optional_notes": {"type": "string"}
  },
  "$defs": {
    "vector2": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 2
    }
  },
  "additionalProperties": false
}
